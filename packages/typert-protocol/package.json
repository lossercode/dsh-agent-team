{
  "name": "@deepseek-ai/dsh-typert-protocol",
  "description": "Vendored copy of the dsh Typert protocol so the Typert generator recognizes the Remote metadata in this workspace. Not published.",
  "version": "0.2.2-rc.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-info": {
      "types": "./lib/types/remote-info.d.ts",
      "default": "./lib/types/remote-info.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  }
}
